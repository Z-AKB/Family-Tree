# Copy to .env or set these where you host the app
# Use production to disable demo seeding by default, require JWT_SECRET, and stop
# printing password-reset emails to the console.
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Folder for the database and photos (use a persistent volume when hosting)
DATA_DIR=./data
# Optional: override the database file path (defaults to DATA_DIR/family.db)
# DB=./data/family.db
# Failed sign-in/reset/password-change attempts per IP per 15 minutes (default 20)
# AUTH_LIMIT=20
# Demo seeding is automatic outside production. Set to 1 to enable it explicitly.
SEED_DEMO=0
# Password-reset email and public links
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=Family Tree <no-reply@example.com>
# APP_URL=https://your-domain.example
